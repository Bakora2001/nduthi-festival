// ==========================================================
// Nduthi Festival & Awards Kenya - Prisma Schema
// Generated from Technical Implementation Document (TID) v1.2
// Section 6: Database Entities
// ==========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// Enums
// ---------------------------------------------------------

enum RoleName {
  SUPER_ADMIN
  JUDGE
  SPONSOR
  NOMINEE
  REGISTERED_VOTER
  GUEST_VISITOR
}

enum PaymentMethod {
  MPESA
  AIRTEL_MONEY
  VISA
  MASTERCARD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum NomineeImageType {
  MOTORCYCLE_PHOTO
  NUMBER_PLATE
}

// ---------------------------------------------------------
// Core Identity
// ---------------------------------------------------------

model User {
  id                String    @id @default(uuid())
  firstName         String
  lastName          String
  email             String    @unique
  phone             String?   @unique
  passwordHash      String
  isEmailVerified   Boolean   @default(false)
  emailVerifyToken  String?
  resetToken        String?
  resetTokenExpiry  DateTime?
  refreshToken      String?
  roleId            String
  role              Role      @relation(fields: [roleId], references: [id])
  votes             Vote[]
  payments          Payment[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  nominee           Nominee?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("users")
}

model Role {
  id    String   @id @default(uuid())
  name  RoleName @unique
  users User[]

  @@map("roles")
}

// ---------------------------------------------------------
// Festival Content
// ---------------------------------------------------------

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  coverImage  String?
  isActive    Boolean   @default(true)
  nominees    Nominee[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model Nominee {
  id                String              @id @default(uuid())
  name              String
  county            String?
  ownerName         String?
  categoryId        String
  category          Category            @relation(fields: [categoryId], references: [id])
  motorcycleId      String?
  motorcycle        Motorcycle?         @relation(fields: [motorcycleId], references: [id])
  userId            String?             @unique
  user              User?               @relation(fields: [userId], references: [id])
  imageUrl          String?
  displayImageType  NomineeImageType    @default(MOTORCYCLE_PHOTO)
  voteCount         Int                 @default(0)
  isFeatured        Boolean             @default(false)
  votes             Vote[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([categoryId])
  @@map("nominees")
}

model Motorcycle {
  id                String              @id @default(uuid())
  make              String
  model             String
  registrationPlate String?             @unique
  nominees          Nominee[]
  images            MotorcycleImage[]
  plates            NumberPlateImage[]
  createdAt         DateTime            @default(now())

  @@map("motorcycles")
}

model MotorcycleImage {
  id           String     @id @default(uuid())
  motorcycleId String
  motorcycle   Motorcycle @relation(fields: [motorcycleId], references: [id])
  url          String
  publicId     String?
  createdAt    DateTime   @default(now())

  @@map("motorcycle_images")
}

model NumberPlateImage {
  id           String     @id @default(uuid())
  motorcycleId String
  motorcycle   Motorcycle @relation(fields: [motorcycleId], references: [id])
  url          String
  publicId     String?
  createdAt    DateTime   @default(now())

  @@map("number_plate_images")
}

// ---------------------------------------------------------
// Voting & Payments
// ---------------------------------------------------------

model Vote {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  nomineeId  String
  nominee    Nominee  @relation(fields: [nomineeId], references: [id])
  paymentId  String   @unique
  payment    Payment  @relation(fields: [paymentId], references: [id])
  createdAt  DateTime @default(now())

  @@index([nomineeId])
  @@index([userId])
  @@map("votes")
}

model Payment {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  method        PaymentMethod
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("KES")
  status        PaymentStatus @default(PENDING)
  providerRef   String?       @unique
  vote          Vote?
  transactions  Transaction[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@map("payments")
}

model Transaction {
  id          String   @id @default(uuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id])
  rawPayload  String?
  event       String
  createdAt   DateTime @default(now())

  @@map("transactions")
}

// ---------------------------------------------------------
// Festival Ecosystem
// ---------------------------------------------------------

model Sponsor {
  id        String   @id @default(uuid())
  name      String
  logoUrl   String?
  website   String?
  tier      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("sponsors")
}

model News {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String
  coverImage  String?
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("news")
}

model Gallery {
  id        String   @id @default(uuid())
  title     String?
  imageUrl  String
  publicId  String?
  createdAt DateTime @default(now())

  @@map("gallery")
}

model Event {
  id          String   @id @default(uuid())
  name        String
  description String?
  venue       String?
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime @default(now())

  @@map("events")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String

  @@map("settings")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String?
  entityId  String?
  metadata  String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}
